project_root: ..
assets_root: assets
state_dir: outputs/collection

listen:
  host: 0.0.0.0
  port: 8000

# Runtime paths, libraries and ports are deliberately not configurable here.
teleoperation:
  client_host: auto
  gpu_ids: [0]
  standby_gpu_ids: [1]

profiles:
  shirt_flatten:
    display_name: 服装展平
    scene: shirt_flatten
    dataset_root: data/collections/shirt_flatten
    hil_dataset_root: data/collections/shirt_flatten/hil
    rollout_root: data/collections/shirt_flatten/rollouts
    max_actions: 3600
  shirt_fold:
    display_name: 服装折叠
    scene: shirt_fold
    continuation_source_profile: shirt_flatten
    dataset_root: data/collections/shirt_fold
    hil_dataset_root: data/collections/shirt_fold/hil
    rollout_root: data/collections/shirt_fold/rollouts
    max_actions: 3600

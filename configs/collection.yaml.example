project_root: ..
assets_root: assets
state_dir: outputs/collection

listen:
  host: 0.0.0.0
  port: 8000

# Runtime paths, libraries and ports are deliberately not configurable here.
teleoperation:
  client_host: auto
  gpu_ids: [0]

profiles:

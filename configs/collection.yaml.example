project_root: ..
assets_root: assets
state_dir: outputs/collection

listen:
  host: 0.0.0.0
  port: 8000

# Runtime paths, libraries and ports are deliberately not configurable here.
teleoperation:
  client_host: auto
  gpu_ids: [0]

profiles:
  shirt_flatten:
    display_name: T 恤展平
    scene: shirt_flatten
    dataset_root: data/collections/shirt_flatten
    rollout_root: data/rollouts/shirt_flatten
    intervention_root: data/interventions/shirt_flatten
    max_actions: 3600
  shirt_fold:
    display_name: T 恤折叠（从展平终态续采）
    scene: shirt_fold
    continuation_source_profile: shirt_flatten
    dataset_root: data/collections/shirt_fold
    rollout_root: data/rollouts/shirt_fold
    intervention_root: data/interventions/shirt_fold
    max_actions: 3600

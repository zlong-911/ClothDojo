[package]
title = "ClothDojo Teleop"
description = "Minimal Isaac RTX/OpenXR frontend for Newton-owned simulation"
version = "1.0.0"

[dependencies]
"omni.kit.viewport.window" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.usd.layers" = {}
"omni.hydra.rtx" = {}
"omni.kit.xr.core" = {}
"omni.kit.xr.system.openxr" = {}
"omni.kit.xr.ui.window.viewport" = {}

[settings]
app.content.emptyStageOnStart = true
app.window.title = "ClothDojo Teleop"
app.window.width = 1280
app.window.height = 720
renderer.enabled = "rtx"
renderer.active = "rtx"
persistent.app.viewport.displayOptions = 0

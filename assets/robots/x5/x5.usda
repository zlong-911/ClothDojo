#usda 1.0
(
    customLayerData = {
        string installation = "OpenDriveLab/kai0 integrated base with two complete RoboDojo ARX X5 references and a direct-mounted RoboDojo D455 stand"
        string robot = "RoboDojo Assets/Robots/x5/ARX.usd, including its camera_base and full-resolution camera geometry"
    }
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./payloads/workstation.usdc@
    ]
    upAxis = "Z"
)

over "Robot"
{
    over "Arms"
    {
        over "left"
        {
            over "joints"
            {
                over "joint1"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint2"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint3"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint4"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint5"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint6"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }
            }

            over "camera"
            {
                over "cam_left_wrist"
                {
                    float2 clippingRange = (0.0001, 10)
                    custom string clothdojo:cameraCalibration = "robodojo_simulation_preset"
                    custom string clothdojo:cameraModel = "D435"
                    custom float clothdojo:cameraOutputRollDegrees = 0
                    custom string clothdojo:cameraSource = "provenance/robodojo_wrist_camera.json"
                    custom string clothdojo:cameraStream = "color"
                    float focalLength = 13
                    float horizontalAperture = 20.955
                    float horizontalApertureOffset = 0
                    token projection = "perspective"
                    float verticalAperture = 15.71625
                    float verticalApertureOffset = 0
                    token visibility = "invisible"
                    matrix4d xformOp:transform = ( (0, -1, 0, 0), (0.17364817766693041, 0, 0.984807753012208, 0), (-0.984807753012208, 0, 0.17364817766693041, 0), (0, 0, 0.001, 1) )
                    uniform token[] xformOpOrder = ["xformOp:transform"]
                }
            }
        }

        over "right"
        {
            over "joints"
            {
                over "joint1"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint2"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint3"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint4"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint5"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }

                over "joint6"
                {
                    float physxJoint:armature = 0.01
                    float physxJoint:maxJointVelocity = 286.4789
                }
            }

            over "camera"
            {
                over "cam_right_wrist"
                {
                    float2 clippingRange = (0.0001, 10)
                    custom string clothdojo:cameraCalibration = "robodojo_simulation_preset"
                    custom string clothdojo:cameraModel = "D435"
                    custom float clothdojo:cameraOutputRollDegrees = 0
                    custom string clothdojo:cameraSource = "provenance/robodojo_wrist_camera.json"
                    custom string clothdojo:cameraStream = "color"
                    float focalLength = 13
                    float horizontalAperture = 20.955
                    float horizontalApertureOffset = 0
                    token projection = "perspective"
                    float verticalAperture = 15.71625
                    float verticalApertureOffset = 0
                    token visibility = "invisible"
                    matrix4d xformOp:transform = ( (0, -1, 0, 0), (0.17364817766693041, 0, 0.984807753012208, 0), (-0.984807753012208, 0, 0.17364817766693041, 0), (0, 0, 0.001, 1) )
                    uniform token[] xformOpOrder = ["xformOp:transform"]
                }
            }
        }
    }
}

#usda 1.0
(
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [@./payloads/workstation.usdc@]
    upAxis = "Z"
)

over "Robot"
{
    # Keep the accepted arm home, with both grippers at their fixed open endpoint.
    custom double[] clothdojo:homeJointQ = [0, -0.96, 1.16, 0, -0.3, 0, 0.037, 0.037, 0, -0.96, 1.16, 0, -0.3, 0, 0.037, 0.037]

    over "Bodies"
    {
        # Default transforms are baked from Newton FK at the home above.
        over "body_008"
        {
            matrix4d xformOp:transform = ( (0.0007949059908280987, -0.10062568074688727, -0.9949255153962202, 0), (5.858815086412505e-7, 0.9949243594280368, -0.10062571219184235, 0), (1.0000011544052665, 0.00007955302802997721, 0.000790922825443019, 0), (0.325888991355896, 0.35271838307380676, 1.134922981262207, 1) )
        }
        over "body_009"
        {
            matrix4d xformOp:transform = ( (0.0007949059908280987, -0.10062568074688727, -0.9949255153962202, 0), (-5.858815086412505e-7, -0.9949273024552099, 0.10062571219184235, 0), (-1.0000011544052665, -0.00007955302802997721, -0.0007938658526160935, 0), (0.43808919191360474, 0.35272738337516785, 1.135011911392212, 1) )
        }
        over "body_018"
        {
            matrix4d xformOp:transform = ( (-0.0007975742660486507, 0.10062571184606739, -0.9949255139619727, 0), (6.3075251333089e-7, -0.9949273021870795, -0.10062574423270476, 0), (-1.0000011561076445, -0.00008073571562405846, 0.0007905240836085792, 0), (0.43811172246932983, -0.3527182936668396, 1.134922981262207, 1) )
        }
        over "body_019"
        {
            matrix4d xformOp:transform = ( (-0.0007974074186520852, 0.1006257191319011, -0.9949253447926463, 0), (-6.46527805958641e-7, 0.9949243546019324, 0.10062575153110442, 0), (1.0000009885300916, 0.00008075150348263449, -0.0007933016352361655, 0), (0.3259115219116211, -0.35272738337516785, 1.1350120306015015, 1) )
        }
    }

    over "Joints"
    {
        over "joint_008"
        {
            float state:linear:physics:position = 0.037
            float drive:linear:physics:targetPosition = 0.037
        }
        over "joint_018"
        {
            float state:linear:physics:position = 0.037
            float drive:linear:physics:targetPosition = 0.037
        }
        # Restore the two affine finger equalities from aloha.xml. The
        # workstation payload retains only the leader's position drive.
        over "joint_009" (
            prepend apiSchemas = ["MjcEqualityJointAPI", "NewtonMimicAPI"]
        )
        {
            float state:linear:physics:position = 0.037
            rel newton:mimicJoint = </Robot/Joints/joint_008>
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
        }
        over "joint_019" (
            prepend apiSchemas = ["MjcEqualityJointAPI", "NewtonMimicAPI"]
        )
        {
            float state:linear:physics:position = 0.037
            rel newton:mimicJoint = </Robot/Joints/joint_018>
            float newton:mimicCoef0 = 0
            float newton:mimicCoef1 = 1
        }
    }
}

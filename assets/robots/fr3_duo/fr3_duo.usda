#usda 1.0
(
    customLayerData = {
        string dynamicsSources = "provenance/dynamics.json"
        string status = "Fixed workstation; native FR3 Duo cameras plus independent Piper cam_low observer"
    }
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./payloads/workstation.usdc@
    ]
    upAxis = "Z"
)


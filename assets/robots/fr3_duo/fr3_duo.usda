    def Scope "cameras"
    {
        def Camera "cam_low" (
            documentation = "Independent virtual observer copied from Piper cam_low; no physical camera or mounting hardware."
        )
        {
            float2 clippingRange = (0.01, 100)
            float focalLength = 10
            float horizontalAperture = 14.266
            token projection = "perspective"
            float verticalAperture = 10.6995
            matrix4d xformOp:transform = ( (0, 1, 0, 0), (-0.374606593415912, 0, 0.9271838545667874, 0), (0.9271838545667874, 0, 0.374606593415912, 0), (1.25, 0, 1.35, 1) )
            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:transform"]
        }
    }


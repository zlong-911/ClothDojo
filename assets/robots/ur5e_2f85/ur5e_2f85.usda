    customLayerData = {
        string driveTuning = "ClothDojo 1x-effort simulation damping: arm kd=[120,125,95,18,16,15] Nm*s/rad per side. Inertia-based response tuning, not manufacturer calibration; source kp/effort/passive dynamics preserved."
        string dynamicsUnits = "Newton USD revolute coefficients use degrees; source payload is legacy SI. 1e6 rad/s is an effectively unlimited fallback, not a hardware rating. Robotiq spring values come from fixed Menagerie 2f85.xml."
        string installation = "Dual UR5e plus Robotiq 2F-85 at x=0.15, y=+-0.55, z=0.8; arms and complete D455 stand shifted -0.10 m in X. Virtual cam_low stays world-fixed."

#usda 1.0
(
    defaultPrim = "Robot"
    customLayerData = {
        string installation = "Dual UR5e plus Robotiq 2F-85 workstation at x=0.25, y=+-0.55, with the complete legacy RoboDojo D455 stand on the X5 column axis"
    }
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [@./payloads/workstation.usdc@]
    upAxis = "Z"
)

# Dynamics units: Newton USD revolute coefficients use degrees.
# Source payload values are legacy SI; only these angular properties are converted.
# 1e6 rad/s is the source's effectively unlimited fallback, not a hardware rating.
# Robotiq spring values come from the fixed Menagerie 2f85.xml.
over "Robot"
{
    over "Joints"
    {
        over "joint_001"
        {
            float newton:damping = 0
            float newton:limitStiffness = 43.63323129985824
            float newton:limitDamping = 1.74532925199433
            float newton:velocityLimit = 57295779.51308233

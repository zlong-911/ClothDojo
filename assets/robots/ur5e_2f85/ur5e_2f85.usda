#usda 1.0
(
    customLayerData = {
        string dynamicsUnits = "Newton USD revolute coefficients use degrees; source payload is legacy SI. 1e6 rad/s is an effectively unlimited fallback, not a hardware rating. Robotiq spring values come from fixed Menagerie 2f85.xml."
        string installation = "Dual UR5e plus Robotiq 2F-85 workstation at x=0.25, y=+-0.55, with the complete legacy RoboDojo D455 stand on the X5 column axis"
        string wristCameraSource = "provenance/wrist_camera/README.md"
    }
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./payloads/workstation.usdc@
    ]
    upAxis = "Z"
)


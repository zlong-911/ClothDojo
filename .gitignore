!/assets/robots/x5/x5.usda
!/assets/robots/x5/build_workstation.py
!/assets/robots/x5/CLOTHDOJO.md
!/assets/robots/ur5e_2f85/CLOTHDOJO.md
!/assets/robots/fr3_duo/

/data
checkpoints/

# Collection deployment settings are copied from the tracked example.
/configs/collection.yaml

# Complete project-local payloads are managed outside Git. The lightweight
# Piper workstation entry is source because it owns project physics semantics.
/assets/*
!/assets/robots/
/assets/robots/*
!/assets/robots/aloha2/
/assets/robots/aloha2/*
!/assets/robots/aloha2/aloha2.usda
